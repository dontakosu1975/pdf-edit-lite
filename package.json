{
  "name": "pdf-edit-lite",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "description": "Local desktop PDF editor MVP",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "vite": "^7.1.7",
    "wait-on": "^8.0.3"
  }
}
